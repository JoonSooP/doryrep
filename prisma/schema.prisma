generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                 String   @id @default(cuid())
  loginId            String   @unique
  name               String
  email              String   @unique
  password           String
  role               String   @default("Viewer")
  userType           String   @default("프로젝트팀")
  mustChangePassword Boolean  @default(true)
  avatar             String?
  tasks              Task[]
  memberships        ProjectMember[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ProjectMember {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
}

model Project {
  id          String      @id @default(cuid())
  name        String
  description String?
  tasks          Task[]
  demos          Demo[]
  milestones     Milestone[]
  weeklyReports  WeeklyReport[]
  issues         Issue[]
  actionItems    ActionItem[]
  members        ProjectMember[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Milestone {
  id         String      @id @default(cuid())
  title      String
  assignee   String?
  color      String?
  startDate  String?
  endDate    String?
  priority   String      @default("중")
  progress   Int         @default(0)
  order      Int         @default(0)
  parent     Milestone?  @relation("MilestoneTree", fields: [parentId], references: [id])
  parentId   String?
  children      Milestone[]   @relation("MilestoneTree")
  weeklyEntries WeeklyEntry[]
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model WeeklyReport {
  id        String        @id @default(cuid())
  weekDate  String
  weekLabel String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  entries   WeeklyEntry[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model WeeklyEntry {
  id           String       @id @default(cuid())
  lastWeek     String       @default("")
  thisWeek     String       @default("")
  issues       String       @default("")
  issueIds     String       @default("")
  report       WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId     String
  milestone    Milestone    @relation(fields: [milestoneId], references: [id])
  milestoneId  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Demo {
  id            String       @id @default(cuid())
  title         String
  scenario      String       @default("")
  type          String       @default("link")
  link          String?
  image         String?
  images        String       @default("[]")
  actions       String       @default("[]")
  application   Application? @relation(fields: [applicationId], references: [id])
  applicationId String?
  order         Int          @default(0)
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Application {
  id        String   @id @default(cuid())
  name      String   @unique
  command   String
  icon      String?
  demos     Demo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Issue {
  id              String   @id @default(cuid())
  number          Int      @default(0)
  category        String   @default("")
  registeredAt    String
  issueCode       String   @default("")
  description     String   @default("")
  issueType       String   @default("이슈")
  assignee        String   @default("")
  responsible     String   @default("")
  result          String   @default("")
  status          String   @default("Open")
  planStartDate   String?
  planEndDate     String?
  actualStartDate String?
  actualEndDate   String?
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ActionItem {
  id              String   @id @default(cuid())
  number          Int      @default(0)
  category        String   @default("")
  actionCategory  String   @default("")
  description     String   @default("")
  priority        String   @default("중")
  requester       String   @default("")
  assignee        String   @default("")
  requestDate     String?
  startDate       String?
  endDate         String?
  progress        Int      @default(0)
  workContent     String   @default("")
  status          String   @default("Open")
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      String     @default("TODO")
  order       Int        @default(0)
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  assignee    User?      @relation(fields: [assigneeId], references: [id])
  assigneeId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
